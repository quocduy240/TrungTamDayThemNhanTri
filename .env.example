# GEMINI_API_KEY: Required for Gemini AI API calls (test paper OCR, student list import, 24/7 advisor).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional HMAC signing secret for API session tokens (falls back to secure runtime key).
SESSION_SECRET=

# ADMIN_PASSCODE: Optional custom admin passcode for CMS management sign-in.
ADMIN_PASSCODE=
