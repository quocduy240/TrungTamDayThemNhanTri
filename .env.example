# GEMINI_API_KEY: Required for Gemini AI API calls (test paper OCR, student list import, 24/7 advisor).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Required in production for persistent HMAC signing of API session tokens.
SESSION_SECRET=

# ALLOW_DEMO_LOGIN: Set to "false" in production to disable quick demo role switching.
ALLOW_DEMO_LOGIN="false"

# ADMIN_PASSCODE: Optional custom admin passcode for CMS management sign-in.
ADMIN_PASSCODE=
